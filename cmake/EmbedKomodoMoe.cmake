file(READ "${LOOK_DEFINITIONS}" look_definitions)
string(REGEX MATCH "#define AP_LOOK_KOMODO_MOE_SIZE ([0-9]+)u" size_define "${look_definitions}")
set(expected_size "${CMAKE_MATCH_1}")
string(REGEX MATCH "#define AP_LOOK_KOMODO_MOE_SHA256 \"([0-9a-f]+)\"" hash_define "${look_definitions}")
set(expected_hash "${CMAKE_MATCH_1}")

file(SIZE "${INPUT}" model_size)
file(SHA256 "${INPUT}" model_hash)
if(NOT model_size STREQUAL expected_size OR NOT model_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Komodo Moe model size or SHA-256 differs from ap/ap_look_logic.h: ${INPUT}")
endif()

file(READ "${INPUT}" model_hex HEX)
string(REPEAT "[0-9a-f][0-9a-f]" 12 row_pattern)
string(REGEX REPLACE "(${row_pattern})" "\\1\n    " model_rows "${model_hex}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " model_bytes "${model_rows}")
string(REPLACE ", \n" ",\n" model_bytes "${model_bytes}")
string(STRIP "${model_bytes}" model_bytes)
file(WRITE "${OUTPUT}"
    "/* Generated by EmbedKomodoMoe.cmake from komodo_moe_hi.bin. */\n"
    "static const unsigned char ap_komodo_moe_embedded[] = {\n    ${model_bytes}\n};\n"
)
