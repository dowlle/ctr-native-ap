+                stem == "CONIN$" || stem == "CONOUT$" || stem == "CONERR$" ||
+                (stem.size() == 4 && (stem.substr(0, 3) == "COM" || stem.substr(0, 3) == "LPT") &&
+                 stem[3] >= '1' && stem[3] <= '9'))
+                return true;
+            return std::any_of(value.begin(), value.end(), [](unsigned char c) {
+                return c < 32 || c == 127;
+            });
+        };
+        if (safe_game.empty() || safe_checksum != checksum ||
