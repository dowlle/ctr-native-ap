+            auto stem = value.substr(0, value.find('.'));
+            while (!stem.empty() && stem.back() == ' ') stem.pop_back();
+            std::transform(stem.begin(), stem.end(), stem.begin(), [](unsigned char c) {
+                return c >= 'a' && c <= 'z' ? c - 'a' + 'A' : c;
+            });
